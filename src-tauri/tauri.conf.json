{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toodo",
  "version": "0.9.2",
  "identifier": "dev.toodo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toodo",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RkY1QTA1MDVCNzM1MTQKUldRVU5iY0ZCVnIvUko4Y0ZpOFZUUXlXV3pWUlQ1ZzUzcGxvK2RpU2xIenN0UG1mWTFURTN3QnoK",
      "endpoints": ["https://github.com/bok-dong/toodo/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
